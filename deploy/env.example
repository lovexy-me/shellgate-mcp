# ShellGate configuration. Keep this file private (chmod 600).

# Bearer token clients must send: Authorization: Bearer <token>. At least 32 characters.
SHELLGATE_TOKEN=change-me

# Listen only on loopback; publish through Cloudflare Tunnel instead of opening ports.
SHELLGATE_HOST=127.0.0.1
SHELLGATE_PORT=8790

# full      = any command; dangerous ones need a one-time confirm code
# allowlist = only programs listed in SHELLGATE_ALLOWED_COMMANDS, and file reads confined too
SHELLGATE_MODE=full
#SHELLGATE_ALLOWED_COMMANDS=ls,cat,grep,tail,df,free,docker,systemctl,journalctl,git

# Where write_file / edit_file may write (comma-separated). Default: your home and /tmp.
#SHELLGATE_ALLOWED_DIRS=/home/you,/tmp,/opt/1panel/apps

# Extra paths file tools must never touch (config, audit, ~/.ssh, ~/.cloudflared are always protected).
#SHELLGATE_PROTECTED_PATHS=/home/you/secrets

# Extra regexes that require confirmation, comma-separated.
#SHELLGATE_DANGER_PATTERNS=npm\s+publish,terraform\s+destroy

#SHELLGATE_DEFAULT_TIMEOUT=60
#SHELLGATE_MAX_TIMEOUT=600
#SHELLGATE_MAX_OUTPUT_BYTES=100000
#SHELLGATE_MAX_CONCURRENT=4
#SHELLGATE_MAX_JOBS=8
#SHELLGATE_CONFIRM_TTL=300
#SHELLGATE_BACKUP_ON_WRITE=true
#SHELLGATE_SHELL=/bin/bash
#SHELLGATE_STATE_DIR=~/.local/state/shellgate
