<html><head><meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>ShellGate PE</title>
<hta:application id="sg" applicationname="ShellGatePE" border="thin" maximizebutton="no" singleinstance="yes" scroll="no"/>
<style>
body{font-family:"Microsoft YaHei","SimSun",sans-serif;background:#1f2933;color:#e4e7eb;margin:12px}
h1{font-size:18px;margin:0 0 8px} .g{display:grid;grid-template-columns:1fr 1fr;gap:6px}
button{font-size:14px;padding:8px;text-align:left;background:#323f4b;color:#fff;border:1px solid #52606d;cursor:pointer}
button:hover{background:#3e4c59} #st{font-size:12px;color:#9aa5b1;margin-top:8px}
</style>
<script language="VBScript">
Sub Window_OnLoad
  window.resizeTo 560, 600
End Sub
</script>
<script language="JScript">
var sh = new ActiveXObject("WScript.Shell");
var P = "X:\\Program Files\\ShellGatePE\\";
function run(c){ try{ sh.Run(c,1,false); }catch(e){ document.getElementById("st").innerText = "无法启动: " + c; } }
function q(s){ return '"' + s + '"'; }
</script></head>
<body><h1>ShellGate PE 救援菜单</h1>
<div class="g">
<button onclick="run(q(P+'explorerpp\\Explorer++.exe'))">文件管理 Explorer++</button>
<button onclick="run(q(P+'notepadpp\\notepad++.exe'))">编辑器 Notepad++</button>
<button onclick="run(q(P+'testdisk\\qphotorec_win.exe'))">文件恢复 QPhotoRec</button>
<button onclick="run(q(P+'testdisk\\testdisk_win.exe'))">分区恢复 TestDisk</button>
<button onclick="run('cmd /k '+q(P+'bin\\win-install.cmd')+' help')">装系统 / 引导修复</button>
<button onclick="run('cmd /k '+q(P+'bin\\win-offline.cmd')+' help')">离线注册表 / 密码</button>
<button onclick="run(q(P+'7zip-full\\7zFM.exe'))">7-Zip</button>
<button onclick="run('powershell -NoLogo')">PowerShell</button>
<button onclick="run('cmd /k wpeutil InitializeNetwork ^& ipconfig')">联网 / IP</button>
<button onclick="run('powershell -NoLogo -NoExit -ExecutionPolicy Bypass -File '+q(P+'bin\\sg.ps1')+' status')">ShellGate 状态</button>
<button onclick="run('powershell -NoLogo -NoExit -ExecutionPolicy Bypass -File '+q(P+'bin\\sg.ps1')+' restart')">ShellGate 重启</button>
<button onclick="run('powershell -NoLogo -NoExit -ExecutionPolicy Bypass -File '+q(P+'bin\\sg.ps1')+' mode local')">模式: 本机</button>
<button onclick="run('powershell -NoLogo -NoExit -ExecutionPolicy Bypass -File '+q(P+'bin\\sg.ps1')+' mode lan')">模式: 局域网</button>
<button onclick="run('powershell -NoLogo -NoExit -ExecutionPolicy Bypass -File '+q(P+'bin\\sg.ps1')+' mode tunnel')">模式: 隧道</button>
<button onclick="run('wpeutil reboot')">重启</button>
<button onclick="run('wpeutil shutdown')">关机</button>
</div><div id="st">远程: ShellGate 在后台运行（令牌在 U 盘 \shellgate\shellgate.env，镜像内没有）。</div>
</body></html>
