# ShellGate rescue-stick config template. The flashing script (or you) fills in `token`
# locally; never commit a filled-in copy. Generate a token with: shellgate --gen-token
token=

# local (default, 127.0.0.1) | lan (0.0.0.0, same LAN) | tunnel (needs tunnel_token)
#net=lan
#tunnel_token=
#mdns_name=ventoy-rescue
