# ShellGate (OpenWrt) configuration. Keep private: chmod 600 /etc/shellgate/env
SHELLGATE_TOKEN=change-me

# 127.0.0.1 when cloudflared runs on the router itself.
# Use the router's LAN IP (e.g. 192.168.1.1) when cloudflared runs on another machine in your LAN.
SHELLGATE_HOST=127.0.0.1
SHELLGATE_PORT=8790

# full | allowlist
SHELLGATE_MODE=full
#SHELLGATE_ALLOWED_COMMANDS=uci,logread,ubus,ip,ping,cat,ls,df,free,opkg

# Where write_file / edit_file may write
SHELLGATE_ALLOWED_DIRS=/tmp,/root,/etc/config

# Audit log lives in RAM (/var -> /tmp) to spare the flash; it is lost on reboot.
SHELLGATE_STATE_DIR=/var/log/shellgate
SHELLGATE_AUDIT_MAX_BYTES=1000000

# Small devices: keep these low
SHELLGATE_MAX_CONCURRENT=2
SHELLGATE_MAX_JOBS=4
SHELLGATE_MAX_OUTPUT_BYTES=65536
#SHELLGATE_DANGER_PATTERNS=opkg\s+remove
